@page "/account"
@rendermode RenderMode.InteractiveServer
<PageTitle>Профиль - Цифровое портфолио</PageTitle>

@if (!AccountService.Initialized)
    return;

@if (AccountService.IsLogged)
{
    <DiplomBeb.Components.Pages.Auth.Profile/>
}
else
{
    <DiplomBeb.Components.Pages.Auth.Signin/>
}