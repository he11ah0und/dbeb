@page "/library/{Page:long}"
@rendermode RenderMode.InteractiveServer

<main>
    <div>
        <div class="middle">
            <div class="heading">
                <div>Библиотека полезных ссылок</div>
            </div>
            <div class="container-list">
                <div class="link-list">
                    @if (MainService.Library.Libs != null)
                    {
                        @for (long i = 1; i <= MainService.Library.Libs.LongLength; i++)
                        {
                            <div>
                                <a target="_blank"
                                   href="@MainService.Library.Libs[i - 1].Link">
                                    <h4>@MainService.Library.Libs[i - 1].Name</h4>
                                </a>
                            </div>
                        }
                    }
                </div>
                <div class="footer">
                    <div class="footer-left">
                        <button class="update" @onclick="Update">
                            <img class="img-update" src="icons/update.svg" alt="">
                        </button>
                    </div>
                    <div class="footer-right">
                        @if (CanNext)
                        {
                            <button class="nazad">
                                <img src="icons/nazad.svg" alt="">
                            </button>
                        }
                        @for (ulong i = 1; i <= MainService.Library.TotalPages; i++)
                        {
                            var page = i;
                            <button @onclick="() => { OpenPage(page); }">1</button>
                        }
                        @if (CanNext)
                        {
                            <button href="" class="vpered">
                                <img src="icons/vpered.svg" alt="">
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div>
            <div class="place-container">
                <div class="heading">
                    <h4>Фильтры</h4>
                </div>
                <div class="filters-list">
                    <div class="colum">
                        <div>
                            <input type="checkbox" name="">
                            <h4>Для студентов</h4>
                        </div>
                        <div>
                            <input type="checkbox" name="r">
                            <h4>Для школьников</h4>
                        </div>
                        <div>
                            <input type="checkbox" name="">
                            <h4>Для работающих</h4>
                        </div>
                        <div>
                            <input type="checkbox" name="">
                            <h4>Курсы</h4>
                        </div>
                        <div>
                            <input type="checkbox" name="">
                            <h4>Конкурсы</h4>
                        </div>
                        <div>
                            <input type="checkbox" name="">
                            <h4>Олимпиады</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>