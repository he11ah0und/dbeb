@page "/documents"
@using DiplomBeb.Components.Views

@rendermode RenderMode.InteractiveServer
<PageTitle>Документы - Цифровое портфолио</PageTitle>

<div class="main-div">
    <div class="middle">
        <div class="heading">
            <div class="heading-top">Управление документами</div>
            <div class="heading-buttons">
                <button class="download" @onclick="DownloadSelectedDocuments">Скачать</button>
                <div></div>
                <button class="unload" @onclick="DocumentsService.DocumentUploader.Show">Отправить</button>
                <button class="delete" @onclick="RemoveSelectedDocuments">Удалить</button>
            </div>
        </div>
        <ViewList
            ListView="DocumentsService.DocumentsListView"/>
    </div>

    <div class="place-container">
        <div class="place-heading">Фильтры</div>
        <ViewList
            ListView="DocumentsService.FiltersDocumentsListView"/>
    </div>
</div>

<ViewUploader
    Uploader="DocumentsService.DocumentUploader"/>



