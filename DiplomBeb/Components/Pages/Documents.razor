@page "/documents"
@using DiplomBeb.Components.Views
@rendermode RenderMode.InteractiveServer
<PageTitle>Документы - Цифровое портфолио</PageTitle>
<script src="scripts/interop.js"></script>

<div class="main-div">
    <div class="middle">
        <div class="heading">
            <div class="heading-title">Управление документами</div>
            <div class="heading-buttons">
                <button class="download" @onclick="DownloadSelectedDocuments">Скачать</button>
                <div></div>
                <button class="unload" @onclick="ShowUploader">Отправить</button>
                <button class="delete" @onclick="RemoveSelectedDocuments">Удалить</button>
            </div>
        </div>
        <ViewList
            ListView="AccountService.DocumentsService.DocumentsListView"/>
    </div>

    <div class="place-container">
        <div class="place-heading">Фильтры</div>
        <ViewList
            ListView="AccountService.DocumentsService.FiltersDocumentsListView"/>
    </div>
</div>

@if (InUpload)
{
    <div class="loading-window-cont">
        <div class="loading-window-back" @onclick="HideUploader"></div>

        <div class="loading-window">
            <InputFile OnChange="Callback"/>
            <img src="images/img-doc.svg" alt="Документ"/>
            <div class="loading-window-button">
                <button class="review">Обзор</button>
                <button class="send-mod" @onclick="UploadSelectedDocuments">Отправить</button>
            </div>
            <h3>Добавьте изображение</h3>
        </div>
    </div>
}



