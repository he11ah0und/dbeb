@using DiplomBeb.Components.Views
@rendermode RenderMode.InteractiveServer

@{
    var src = AccountService.AvatarImage is { LongLength: > 0 } avatar ? $"data:image;base64, {Convert.ToBase64String(avatar)}": "/images/prof-foto-img.png";
}

<div class="main-div">
    <div class="middle">
        <div class="heading">
            <div>Профиль</div>
        </div>
        <div class="container-list">
            <div class="place-linner-top">
                <div class="column-img">
                    <img class="img39" alt="" src="@src"/>
                    <button class="upload-photo" @onclick="AccountService.AvatarUploader.Show">
                        <img src="icons/upload-photo.svg" alt="аватар"/>
                    </button>
                </div>
                <div class="profile-list">
                    <div class="list-line">
                        <h4>ФИО:</h4>
                        @if (InEdit)
                        {
                            <div class="edit-fields">
                                <input type="text" @bind="Surname" placeholder="Фамилия" />
                                <input type="text" @bind="Name" placeholder="Имя" />
                                <input type="text" @bind="Middlename" placeholder="Отчество (при наличии)" />
                            </div>
                        }
                        else
                        {
                            <span>@AccountService.Account?.GetCombined(" ","surname", "name", "middlename")</span>
                        }
                    </div>
                    <div class="list-line">
                        <h4>Место:</h4>
                        <button @onclick="OpenPlace">
                            @AccountService.Account?.Get("place_name")
                        </button>
                    </div>
                    <div class="list-line">
                        <h4>Email:</h4>
                        @if (InEdit)
                        {
                            <div class="edit-fields">
                                <input type="email" @bind="Email" placeholder="example@email.com" />
                            </div>
                            
                        }
                        else
                        {
                            <span>@AccountService.Account?.Get("email")</span>
                        }
                    </div>
                    <div class="list-line">
                        <h4>Номер телефона:</h4>
                        @if (InEdit)
                        {
                            <div class="edit-fields">
                                <input type="number" @bind="Phone" placeholder="+7-XXX-XXX-XX-XX" />
                            </div>
                        }
                        else
                        {
                            <span>@AccountService.Account?.Get("phone", "")</span>
                        }
                    </div>
                    <div class="list-line">
                        <h4>Звёзд:</h4>
                        <span>@AccountService.Account?.Get("score")</span>
                    </div>
                    <div class="list-line">
                        <h4>Место в ТОПе:</h4>
                        <span>@AccountService.Account?.Get("id")</span>
                    </div>
                </div>
            </div>
            
            <div class="place-linner-button">
                <button class="button_change" @onclick="EditMode"><SVG Class="red-icon" Source="/icons/redactir-ico.svg"/>ИЗМЕНИТЬ</button>
                <button class="button_exit" @onclick="OnLogOut">ВЫЙТИ</button>
                <button class="button_change" @onclick="GoToDocuments"><SVG Class="red-icon" Source="/icons/redactir-ico.svg"/>ИЗМЕНИТЬ ДОКУМЕНТЫ</button>
            </div>
        </div>
    </div>
    
    <div class="middle">
        <ViewList
            ListView="DocumentsService.ProfileListView"/>
    </div>
</div>

<ViewUploader 
    Uploader="AccountService.AvatarUploader"/>