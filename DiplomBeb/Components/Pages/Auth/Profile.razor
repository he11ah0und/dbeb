@using DiplomBeb.Components.Views
@rendermode RenderMode.InteractiveServer

<div class="main-div">
    <div class="middle">
        <div class="heading">
            <div>Профиль</div>
        </div>
        <div class="container-list">
            <div class="place-linner-top">
                <div class="column-img">
                    <img class="img39" src="images/prof-foto-img.svg" alt="Фото автара"/>
                </div>
                <table class="profile-table">
                    <tbody>
                    <tr>
                        <th>ФИО:</th>
                        <td class="fio-cell">
                            @if (InEdit)
                            {
                                <div class="edit-fields">
                                    <input type="text" @bind="Surname" placeholder="Фамилия"/>
                                    <input type="text" @bind="Name" placeholder="Имя"/>
                                    <input type="text" @bind="Middlename" placeholder="Отчество (при наличии)"/>
                                </div>
                            }
                            else
                            {
                                <span>@AccountService.Account.Get("surname") @AccountService.Account.Get("name") @AccountService.Account.Get("middlename")</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <th>Место:</th>
                        <td>
                            <button @onclick="OpenPlace">
                                @AccountService.Account?.Get("place_name")
                            </button>
                        </td>
                    </tr>
                    
                    <tr>
                        <th>Email:</th>
                        <td>
                            @if (InEdit)
                            {
                                <input type="email" @bind="Email" placeholder="example@email.com"/>
                            }
                            else
                            {
                                <span>@AccountService.Account?.Get("email")</span>
                            }
                        </td>
                    </tr>

                    <tr>
                        <th>Номер телефона:</th>
                        <td>
                            @if (InEdit)
                            {
                                <input type="number" @bind="Phone" placeholder="+7-XXX-XXX-XX-XX"/>
                            }
                            else
                            {
                                <span>@AccountService.Account?.Get("phone", "")</span>
                            }
                        </td>
                    </tr>
                    
                    <tr>
                        <th>Звёзд:</th>
                        <td>@AccountService.Account?.Get("score")</td>
                    </tr>
                    
                    <tr>
                        <th>Место в ТОПе:</th>
                        <td>@AccountService.UserRank.Position</td>
                    </tr>
                    </tbody>
                </table>
            </div>
            
            <div class="place-linner-button">
                <button class="button_change" @onclick="EditMode">
                    <img class="img38" src="icons/redactir-ico.svg" alt="Редактировать"/>
                    <h4>ИЗМЕНИТЬ</h4>
                </button>
                <button class="button_exit" @onclick="OnLogOut">
                    <h4>ВЫЙТИ</h4>
                </button>
                <button class="button_change" @onclick="GoToDocuments">
                    <img class="img38" src="icons/redactir-ico.svg" alt="Редактировать"/>
                    <h4>ИЗМЕНИТЬ ДОКУМЕНТЫ</h4>
                </button>
            </div>
        </div>
    </div>
    
    <div class="middle">
        <ViewList
            ListView="AccountService.DocumentsService.ListView"/>
