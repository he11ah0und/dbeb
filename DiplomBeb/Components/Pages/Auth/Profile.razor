@rendermode RenderMode.InteractiveServer

<PageTitle>Личное портфолио - профиль</PageTitle>

<main>
        <div>
            <div class="middle">
                <div class="heading">
                    <div>Профиль</div>
                </div>
                <div class="container-list">
                    <div class="place-inner-top">
                        <div class="place-column">
                            <div class="column-right">
                                <img class="img39" src="images/prof-foto-img.svg" alt="Фото автара" />
                            </div>
                            <div class="column-center">
                                <div>
                                    <h3>ФИО:</h3>
                                    <h4>@AccountService.Account.Surname @AccountService.Account.Name @AccountService.Account.Middlename</h4>
                                </div>
                                <div>
                                    <h3>Место:</h3>
                                    <h4>@AccountService.Account?.Place?.Content</h4>
                                </div>
                                <div>
                                    <h3>Звёзд:</h3>
                                    <h4>@AccountService.Account.Score</h4>
                                </div>
                                <div>
                                    <h3>Место в ТОПе:</h3>
                                    <h4>@AccountService.UserRank.Position</h4>
                                </div>
                            </div>
                            <dfiv class="column-left">
                                <div>
                                    <h3>Email:</h3>
                                    <h4>@AccountService.Account.Email</h4>
                                </div>
                                <div>
                                    <h3>Номер телефона:</h3>
                                    <h4>@AccountService.Account.Phone</h4>
                                </div>
                            </dfiv>
                        </div>
                    </div>
                    <div class="place-linner-bottom">
                        <button href="../profile2/index.html"  class="button_change">
                            <img class="img38" src="icons/redactir-ico.svg" alt="Редактировать" />
                            <h4>ИЗМЕНИТЬ</h4>
                        </button>

                        <button href="../login/index.html" class="button_exit" @onclick="OnLogOut">
                            <h4>ВЫЙТИ</h4>
                        </button>
                    </div>
                </div>
            </div>
            <div class="middle">
                <div class="heading">
                    <div>Грамоты</div>
                </div>
                <div class="container-list">
                    <div class="place-inner-top">
                        <duv class="awards">
                            <img class="img36" src="images/gram1-img.svg" alt="Редактировать" />
                            <img class="img36" src="images/gram2-img.svg" alt="Редактировать" />
                            <img class="img36" src="images/gram3-img.svg" alt="Редактировать" />
                            <img class="img36" src="images/gram4-img.svg" alt="Редактировать" />
                            <img class="img36" src="images/gram5-img.svg" alt="Редактировать" />
                            <img class="img36" src="images/gram6-img.svg" alt="Редактировать" />
                        </duv>
                    </div>
                    <div class="place-linner-bottom">
                        <a href="../awards/index.html">
                            <button class="button_change">
                                <img class="img38" src="icons/redactir-ico.svg" alt="Редактировать" />
                                <h4>ИЗМЕНИТЬ</h4>
                            </button>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </main>
