@using DiplomBeb.Components.Views
@rendermode RenderMode.InteractiveServer

<PageTitle>Личное портфолио - Вход</PageTitle>

<div class="main-div">
    <div class="place-column">
        <div class="linner-left">
            <SVG Class="logo-icon-ver" Source="/icons/logo-ico.svg"/>
        </div>
        <div class="linner-right">
            <div class="heading">
                <h1>Авторизация</h1>
            </div>
            
            <div class="warp">
                <div class="place-linner-1">
                    <div>
                        <input type="email"@bind="Email" placeholder="">
                        <label>Email/номер телефона</label>
                    </div>
                    <div>
                        <input type="password" @bind="Password" placeholder="">
                        <label>Пароль</label>
                    </div>
                </div>

                <div class="place-linner-2">
                    <h4>Забыли пароль?</h4>
                    <a href="../recovery/index.html">Восстановить</a>
                </div>


                <div class="place-linner-3">
                    <button class="button_registration" @onclick="HandleValidSubmit">войти</button>
                    <div class="horizontal-line"></div>
                </div>

                <div class="place-linner-4">
                    <h4>У вас уже есть аккаунт?</h4>
                    <a href="/signup">Зарегистрироваться</a>
                </div>
            </div>
        </div>
    </div>
</div>