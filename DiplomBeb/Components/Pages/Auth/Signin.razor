@rendermode RenderMode.InteractiveServer

<PageTitle>Личное портфолио - Вход</PageTitle>

<main>
    <div>
        <div class="middle">
            <div class="place-container">
                <div class="place-column">
                    <div class="place-linner-left">
                        <div>
                            <img class="img1" src="icons/logo-ico.svg" alt="Логотип портфолио"/>
                        </div>
                    </div>
                    <div class="place-linner-right">
                        <div class="heading">
                            <div>
                                <h1>Авторизация</h1>
                            </div>
                        </div>
                        <div class="warp">

                            <div class="place-linner-1">

                                <div class="linner-text-1">
                                    <input class="input-1" type="email" id="" @bind="Email" placeholder="">
                                    <label class="label-1" for="">Email/номер телефона</label>
                                </div>
                                <div class="linner-text-1">
                                    <input class="input-1" type="password" id="" @bind="Password" placeholder="">
                                    <label class="label-1" for="">Пароль</label>
                                </div>

                            </div>

                            <div class="place-linner-2">
                                <h4>Забыли пароль?</h4>
                                <a href="../recovery/index.html">
                                    <h4>Восстановить</h4>
                                </a>
                            </div>


                            <div class="place-linner-3">
                                <button class="button_registration" @onclick="HandleValidSubmit">
                                    <h4>ВОЙТИ</h4>
                                </button>
                                <div class="horizontal-line"></div>
                            </div>

                            <div class="place-linner-4">
                                <h4>Хотите вернуться к регистрации?</h4>
                                <a href="/signup">
                                    <h4>Зарегистрироваться</h4>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>