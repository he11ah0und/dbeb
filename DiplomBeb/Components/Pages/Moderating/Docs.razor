@page "/special/docs"

<div class="main-div">
    <div class="middle">
        <div class="heading">
            <div>Документы</div>
        </div>
        <div class="container-list">
            <div class="wrapper">
                <div class="title">
                    <h4>Заголовок документа</h4>
                </div>
                <div class="arnold">
                    <div class="image">
                        <img src="" alt=""/>
                    </div>
                </div>
                
                <div class="arnold">
                    <div class="over">
                        <h4>На данный момент документы закончились!</h4>
                    </div>
                </div>
            </div>
            <div class="footer">
                <button class="accept">Принять</button>
                <button class="reject">Отклонить</button>
            </div>
        </div>
        <div class="container-list">
            <div class="title">
                <div class="image-title">
                    <img class="img39" alt="" src="/images/prof-foto-img.svg"/>
                </div>
                <h4>Акакий Акакиевич Акаков</h4>
            </div>
            <div class="dan-title">
                <button class="send">Отправить запрос администратору</button>
            </div>
        </div>
    </div>
</div>

