@page "/special/docs"
@using dshared.Utils
@rendermode RenderMode.InteractiveServer

<PageTitle>Модерация документов - Цифровое портфолио</PageTitle>

<div class="main-div">
    <div class="middle">
        <div class="heading">
            <div>Документы</div>
        </div>

        <div class="scrollable-content">
            <div class="wrapper">
                @if (ModerationService.ProcessDocument is ListElement pdoc && bool.Parse(pdoc.Get("hasWork", "false")))
                {
                    <div class="title">
                        <h4>@pdoc.Get("documentName")</h4>
                    </div>
                    <div class="arnold">
                        <div class="image">
                            @{
                                var src = ModerationService.DocumentImage is null ? "" : $"data:image;base64, {Convert.ToBase64String(ModerationService.DocumentImage)}";
                            }
                            <img src="@src" alt="документ"/>
                        </div>
                    </div>
                }
                else
                {
                    <div class="arnold">
                        <div class="over">
                            <h4>На данный момент документы закончились!</h4>
                        </div>
                    </div>
                }
            </div>
            <div class="footer">
                @if (ModerationService.ProcessDocument is ListElement sdoc && bool.Parse(sdoc.Get("hasWork", "false")))
                {
                    <button class="accept" @onclick="async () => await AcceptDocument(true)">принять</button>
                    <button class="reject" @onclick="async () => await AcceptDocument(false)">отклонить</button>
                    @if (ModerationService.DocumentTypes is ListElement[] dts)
                    {
                        <select @onchange="OnDocumentTypeChange">
                            @foreach (var dt in dts)
                            {
                                <option>@dt.Get("check")</option>
                            }
                        </select>
                    }
                }
            </div>
        </div>
    </div>

    @if (ModerationService.ProcessDocument is ListElement doc && bool.Parse(doc.Get("hasWork", "false")))
    {
        <div class="middle fixed-bottom">
            <div class="container-list">
                <div class="dan-title">
                    <div class="title">
                        <div class="img">
                            <img class="img39" alt="" src="/images/prof-foto-img.png"/>
                        </div>
                        <h4>@doc.GetCombined(" ", "surname", "name", "middlename")</h4>
                    </div>
                    <button>отправить запрос администратору</button>
                </div>
            </div>
        </div>
    }

    @if (!Started)
    {
        <div class="window-cont">
            <div class="window-back"></div>
            <div class="window">
                <h3>@StartText</h3>
                <button @onclick="Begin">приступить</button>
            </div>
        </div>
    }
</div>

