@page "/special/docs"
@rendermode RenderMode.InteractiveServer

<PageTitle>Модерация документов - Цифровое портфолио</PageTitle>

<div class="main-div">
    <div class="middle">
        <div class="heading">
            <div>Документы</div>
        </div>
        <div class="container-list">
            <div class="wrapper">
                <div class="title">
                    <h4>Заголовок документа</h4>
                </div>
                <div class="arnold">
                    <div class="image">
                        <img src="" alt=""/>
                    </div>
                </div>
                <div class="arnold">
                    <div class="over">
                        <h4>На данный момент документы закончились!</h4>
                    </div>
                </div>
            </div>
            <div class="footer">
                <button class="accept">принять</button>
                <button class="reject">отклонить</button>
                <select>
                    <option >Грамота</option>
                    <option>Сертификат</option>
                    <option >Диплом</option>
                </select>
            </div>
        </div>
    </div>
    <div class="middle">
        <div class="container-list">
            <div class="title">
                <div class="image-title">
                    <img class="img39" alt="" src="/images/prof-foto-img.svg"/>
                </div>
                <h4>Акакий Акакиевич Акаков</h4>
            </div>
            <div class="dan-title">
                <button>отправить запрос администратору</button>
            </div>
        </div>
    </div>

    @if (!Started)
    {
        <div class="window-cont">
            <div class="window-back"></div>

            <div class="window">
                <h3>Нажмите, чтобы начать работу</h3>
                <button @onclick="Begin">приступить</button>
            </div>
        </div>
    }
</div>

