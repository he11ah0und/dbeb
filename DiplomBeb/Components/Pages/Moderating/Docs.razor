@page "/special/docs"
@using DiplomBeb.Components.Views
@rendermode RenderMode.InteractiveServer

<PageTitle>Модерация документов - Цифровое портфолио</PageTitle>

<div class="main-div">
    @{
        var processDoc = ModerationService.ProcessDocument;
        var state = processDoc != null && bool.Parse(processDoc.Get("hasWork", "false"));
    }
    <div class="middle">
        <div class="heading">
            <div>Документы</div>
        </div>
        <div class="wrapper">

            @if (state)
            {
                <div class="title">
                    <input type="text" @bind="DocumentName" />
                </div>
            }
            <div class="scrollable-content">
                @if (state)
                {
                    <div class="arnold">
                        <div class="image">
                            @{
                                var data = Convert.ToBase64String(ModerationService.DocumentImage);
                                var src = ModerationService.DocumentImage is null ? "" : $"data:image;base64, {data}";
                            }
                            <img src="@src" alt="документ" style="transform: rotate(@(Rotation)deg) !important;"/>
                        </div>
                    </div>
                }
                else
                {
                    <div class="arnold">
                        <div class="over">
                            <h4>На данный момент документы закончились!</h4>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    @if (state)
    {
        <div class="middle fixed-bottom">
            <div class="container-list">
                <div class="dan-title">
                    <div class="title">
                        <!--<div class="img">
                            <img class="img39" alt="" src="/images/prof-foto-img.png"/>
                        </div>-->
                        <h4>@processDoc?.GetCombined(" ", "surname", "name", "middlename")</h4>
                    </div>
                    <div class="title">
                        <button class="request">Запрос администратору</button>
                        @if (state)
                        {
                            <button class="accept" @onclick="async () => await AcceptDocument(true)">принять</button>
                            <button class="reject" @onclick="async () => await AcceptDocument(false)">отклонить</button>
                            <button class="turn" @onclick="Rotate"><SVG Class="turn-icon" Source="/icons/turn.svg"/>Повернуть</button>
                            @if (ModerationService.DocumentTypes is { } dts)
                            {
                                <select @onchange="OnDocumentTypeChange">
                                    @foreach (var dt in dts)
                                    {
                                        <option>@dt.Get("check")</option>
                                    }
                                </select>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @if (!Started)
    {
        <div class="window-cont">
            <div class="window-back"></div>
            <div class="window">
                <h3>@StartText</h3>
                <button @onclick="Begin">приступить</button>
            </div>
        </div>
    }
</div>

