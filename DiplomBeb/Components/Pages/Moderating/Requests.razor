<div class="main-div">
    <div class="middle">
        <ViewList
            ListView="AccountService.DocumentsService.ProfileListView"/>
    </div>
    
    <div class="middle">
        <div class="container-list">
            <div class="container-title">
                <div class="image">
                    <img class="img39" alt="" src="/images/prof-foto-img.png"/>
                </div>
                <h4>Акакий Акакиевич Акаков</h4>
            </div>

            <div class="container-dan">
                <div class="container-dan-title">
                    <h3>Должность</h3>
                </div>
                <div>
                    <h4>Модератор профилей</h4>
                </div>
                <div class="container-dan-title">
                    <h3>Текст запроса</h3>
                </div>
                <div>
                    <h5>Заменить в ФИО фамилию пользователя на Абалдуев. </h5>
                </div>
                <div class="container-button">
                    <button>Перейти в профиль</button>
