@page "/special/profiles"
@rendermode RenderMode.InteractiveServer
@using DiplomBeb.Components.Views
@using dshared.Utils

<div class="main-div">
    <div class="middle">
        <ViewList
            ListView="@ModerationService.UsersListView"/>
    </div>
    @if (ModerationService.SelectedUser is ListElement li)
    {
        <div>
            <div class="place-container">
                <div class="container-title">
                    <div class="image"></div>
                    @if (InEdit)
                    {
                        <div class="edit-fields">
                            <input type="text" @bind="Surname"/>
                            <input type="text" @bind="Name"/>
                            <input type="text" @bind="Middlename"/>
                        </div>
                    }
                    else
                    {
                        <div class="linner">
                            <h4>@li.Get("surname") @li.Get("name") @li.Get("middlename")</h4>
                        </div>
                    }
                </div>
                
                <div class="container-dan">
                    <div>
                        <h4>Email:</h4>
                        @if (InEdit)
                        {
                            <input type="email" @bind="Email"/>
                        }
                        else
                        {
                            <div class="linner">
                                <h5>@li.Get("email")</h5>
                            </div>
                        }
                    </div>
                    <div>
                        <h4>Номер:</h4>
                        @if (InEdit)
                        {
                            <input type="number" @bind="Phone"/>
                        }
                        else
                        {
                            <div class="linner">
                                <h5>@li.Get("phone", "")</h5>
                            </div>
                        }
                    </div>
                    <div>
                        <h4>Место:</h4>
                        @if (InEdit)
                        {
                            <select >
                                <option >КГА ПОУ "ДВТК" 1041</option>
                                <option>КГА ПОУ "ДВТК" 1041</option>
                                <option >КГА ПОУ "ДВТК" 1041</option>
                                <option >КГА ПОУ "ДВТК" 1041</option>
                            </select>
                        }
                        else
                        {
                            <div class="linner">
                                <h5>@li.Get("place_name", "")</h5>
                            </div>
                        }
                    </div>
                </div>
    
                <div class="container-button">
                    <button @onclick="EditMode">Редактировать</button>
                    <button>Отправить<br>запрос администратору</button>
                </div> 
            </div>
        </div>
    }
</div>

<div class="request-window-cont">
    <div class="request-window-back"></div>

    <div class="request-window">
        <h3>Запрос администратору</h3>
        <div class="request-window-linner">
            <div>
                <input type="text" id="user" placeholder=" "/>
                <label for="user">Пользователь</label>
            </div>
            <div>
                <input type="text" id="data" placeholder=" "/>
                <label for="data">Данные</label>
            </div>
            <div>
                <input type="text" id="action" placeholder=" "/>
                <label for="action">Действие</label>
            </div>
        </div>
        <button class="send">Отправить</button>
    </div>
</div>



