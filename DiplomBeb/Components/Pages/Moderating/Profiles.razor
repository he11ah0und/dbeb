@page "/special/profiles"
@rendermode RenderMode.InteractiveServer
@using DiplomBeb.Components.Views
@using dshared.Utils
<PageTitle>Пользователи - Цифровое портфолио</PageTitle>

<div class="main-div">
    <div class="middle">
        <ViewList
            ListView="@ModerationService.UsersListView"/>
    </div>
    @if (Selected)
    {
        <div class="middle">
            <div class="container-list">
                <div class="container-title">
                    @if (InEdit)
                    {
                        <div class="edit-fields">
                            <input type="text" @bind="Surname"/>
                            <input type="text" @bind="Name"/>
                            <input type="text" @bind="Middlename"/>
                        </div>
                    }
                    else
                    {
                        <div class="linner">
                            <span>@Surname @Name @Middlename</span>
                        </div>
                    }
                </div>

                <div class="container-dan">
                    <div>
                        <h4>Email:</h4>
                        @if (InEdit)
                        {
                            <input type="email" @bind="Email"/>
                        }
                        else
                        {
                            <div class="linner">
                                <span>@Email</span>
                            </div>
                        }
                    </div>
                    <div>
                        <h4>Номер:</h4>
                        @if (InEdit)
                        {
                            <input type="number" @bind="Phone"/>
                        }
                        else
                        {
                            <div class="linner">
                                <span>@Phone</span>
                            </div>
                        }
                    </div>
                    <div>
                        <h4>Место:</h4>
                        @if (InEdit)
                        {
                            @if (ModerationService.Places is ListElement[] places)
                            {
                                <!--<InputSelect ValueChanged="">
                                    
                                </InputSelect>-->
                                <select @onchange="OnChangePlace">
                                    <option value="0">Выберите место</option>
                                    @foreach (var place in places)
                                    {
                                        var isSelected = ulong.Parse(place.Get("id", "0")) == PlaceId;
                                        if (isSelected)
                                        {
                                            <option selected value="@place.Get("id")">@place.Get("name")</option>
                                        }
                                        else
                                        {
                                            <option value="@place.Get("id")">@place.Get("name")</option>
                                        }
                                    }
                                </select>
                            }
                        }
                        else
                        {
                            <div class="linner">
                                <span>@ModerationService.SelectedUser.Get("place_name")</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="container-button">
                    <button @onclick="EditMode">Редактировать</button>
                    <button @onclick="ShowRequester">Отправить<br>запрос администратору</button>
                </div>
            </div>
        </div>
    }
</div>

@if (InRequest)
{
    <div class="request-window-cont">
        <div class="request-window-back" @onclick="HideRequester"></div>
        <div class="request-window">
            <h3>Запрос администратору</h3>
            <div class="request-window-linner">
                <div>
                    <input disabled type="text" id="user"/>
                    <label for="user">Пользователь</label>
                </div>
                <div>
                    <input type="text" id="data"/>
                    <label for="data">Запрос</label>
                </div>
            </div>
            <button>Отправить</button>
        </div>
    </div>
}