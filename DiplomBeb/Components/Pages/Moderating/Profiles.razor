@page "/special/profiles"
@rendermode RenderMode.InteractiveServer
@using DiplomBeb.Components.Views
<PageTitle>Пользователи - Цифровое портфолио</PageTitle>

<div class="main-div">
    <div class="middle">
        <ViewList
            ListView="@ModerationService.UsersListView"/>
    </div>
    @if (Selected)
    {
        <div>
            <div class="place-container">
                <div class="container-title">
                    <div class="image">
                        <img class="img39" alt="" src="/images/prof-foto-img.svg"/>
                    </div>
                    @if (InEdit)
                    {
                        <div class="edit-fields">
                            <input type="text" @bind="Surname"/>
                            <input type="text" @bind="Name"/>
                            <input type="text" @bind="Middlename"/>
                        </div>
                    }
                    else
                    {
                        <div class="linner">
                            <h4>@Surname @Name @Middlename</h4>
                        </div>
                    }
                </div>
                
                <div class="container-dan">
                    <div>
                        <h4>Email:</h4>
                        @if (InEdit)
                        {
                            <input type="email" @bind="Email"/>
                        }
                        else
                        {
                            <div class="linner">
                                <h5>@Email</h5>
                            </div>
                        }
                    </div>
                    <div>
                        <h4>Номер:</h4>
                        @if (InEdit)
                        {
                            <input type="number" @bind="Phone"/>
                        }
                        else
                        {
                            <div class="linner">
                                <h5>@Phone</h5>
                            </div>
                        }
                    </div>
                    <div>
                        <h4>Место:</h4>
                        @if (InEdit)
                        {
                            <select >
                                <option >КГА ПОУ "ДВТК" 1041</option>
                                <option>КГА ПОУ "ДВТК" 1041</option>
                                <option >КГА ПОУ "ДВТК" 1041</option>
                                <option >КГА ПОУ "ДВТК" 1041</option>
                            </select>
                        }
                        else
                        {
                            <div class="linner">
                                <h5>@PlaceName</h5>
                            </div>
                        }
                    </div>
                </div>
    
                <div class="container-button">
                    <button @onclick="EditMode">Редактировать</button>
                    <button @onclick="ShowRequester">Отправить<br>запрос администратору</button>
                </div> 
            </div>
        </div>
    }
</div>

@if (InRequest)
{
    <div class="request-window-cont">
        <div class="request-window-back" @onclick="HideRequester"></div>
        <div class="request-window">
            <h3>Запрос администратору</h3>
            <div class="request-window-linner">
                <div>
                    <input disabled type="text" id="user" />
                    <label for="user">Пользователь</label>
                </div>
                <div>
                    <input type="text" id="data"/>
                    <label for="data">Запрос</label>
                </div>
            </div>
            <button class="send">Отправить</button>
        </div>
    </div>
}


