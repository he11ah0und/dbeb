@page "/special/profiles"
@rendermode RenderMode.InteractiveServer
@using DiplomBeb.Components.Views
@using DiplomBeb.Utils.AdaptiveListing
<main>
    <div>
        <div class="middle">
            <ViewList
                ListView="@ModerationService.UsersListView"/>
        </div>
        @if (ModerationService.SelectedUser is ListElement li)
        {
            <div>
                <div class="place-container">
                    <div class="container-title">
                        <div class="image"></div>
                        <h4>@li.Get("surname") @li.Get("name") @li.Get("middlename")</h4>
                    </div>
                
                    <div class="container-dan">
                        <div>
                            <h4>Email:</h4>
                            @if (InEdit)
                            {
                                <input type="email" @bind="Email"/>
                            }
                            else
                            {
                                <h5>@li.Get("email")</h5>
                            }
                        </div>
                        <div>
                            <h4>Номер:</h4>
                            @if (InEdit)
                            {
                                <input type="number" @bind="Phone"/>
                            }
                            else
                            {
                                <h5>@li.Get("phone", "")</h5>
                            }
                        </div>
                        <div>
                            <h4>Место:</h4>
                            @if (InEdit)
                            {
                                <input type="text"/>
                            }
                            else
                            {
                                <h5>@li.Get("place_name", "")</h5>
                            }
                        </div>
                    </div>
    
                    <div class="container-button">
                        <button @onclick="EditMode">Редактировать</button>
                        <button>Отправить<br>запрос администратору</button>
                    </div> 
                </div>
            </div>
        }
	</div>
</main>