@page "/special/profiles"
@rendermode RenderMode.InteractiveServer
@using DiplomBeb.Database.Model
<main>
    <div>
        <div class="warp">
            <div class="heading">
                <div>Пользователи</div>
            </div>
                    
            <div class="container-list">
                <div class="heading-list">
                    <h4>#</h4>
                    <h4>ФИО</h4>
                </div>
                
                <ul class="student-list">
                    @if (ModerationService.Users is User[] users)
                    {
                        for (long i = 0; i < users.LongLength; i++)
                        {
                            if (users[i] is not User user) continue;
                            <li>
                                <div class="image"></div>
                                <div class="name">
                                    <h4>@user.Surname @user.Name @user.Middlename</h4>
                                    <p>@user.WebRole.Name</p>
                                </div>
                            </li>
                        }
                    }
                </ul>
                
                <div class="footer">
                    <div class="footer-left">
                        <bottom class="update" @onclick="Update">
                            <img class="img-update" src="/icons/update.svg" alt="">
                        </bottom>
                    </div>
                    <div class="footer-right">
                        <a href="">
                            <bottom class="nazad">
                                <img src="/icons/nazad.svg" alt="">
                            </bottom>
                        </a>
                        <a href="">1</a>
                        <a href="">2</a>
                        <a href="">3</a>
                        <a href="">
                            <bottom href="" class="vpered">
                                <img src="/icons/vpered.svg" alt="">
                            </bottom>
                        </a>
                    </div>     
                </div>
            </div>
        </div>
        
		<div>
            <div class="place-container">
                <div class="container-title">
                    <div class="image"></div>
                    <h4>Акакий Акакиевич Акаков</h4>
                </div>
                
                <div class="container-dan">
                     <div class="container-dan-title">
                        <h3>Данные</h3>
                     </div>
                     <div>
                        <h4>ФИО:</h4>
                        <h5>Акакий Акакиевич Акаков</h5>
                     </div>
                     <div>
                        <h4>Email:</h4>
                        <h5>akakiy@sberbank.ru</h5>
                     </div>
                     <div>
                        <h4>Номер:</h4>
                        <h5>8 800 555 35-35</h5>
                     </div>
                     <div>
                        <h4>Место:</h4>
                        <h5>КГА ПОУ “ДВТК”</h5>
                     </div>
                </div>
    
                <div class="container-button">
                    <button>Редактировать</button>
                    <button>Отправить<br>запрос администратору</button>
                </div> 
            </div>
		</div>
	</div>
</main>