@page "/special/logs"
@rendermode RenderMode.InteractiveServer
@using DiplomBeb.Components.Views
@using dshared.Utils
<PageTitle>Логи - Цифровое портфолио</PageTitle>

<div class="main-div">
    <div class="middle">
        <ViewList
            ListView="@ModerationService.LogsListView"/>
    </div>
    @if (ModerationService.SelectedLog is ListElement li)
    {
        <div class="middle">
            <div class="container-list">
                <div class="container-title">
                    <div class="image">
                        <img class="img39" alt="" src="/images/prof-foto-img.png"/>
                    </div>
                    <h4>@li.GetCombined(" ","surname", "name", "middlename")</h4>
                </div>
                <div class="container-dan">
                    <div>
                        <h4>Email:</h4>
                        <h5>@li.Get("email")</h5>
                    </div>
                    <div>
                        <h4>Телефон:</h4>
                        <h5>@li.Get("phone", "")</h5>
                    </div>
                    <div class="container-dan-title">
                        <h3>Активность</h3>
                    </div>
                    <div class="container-dan-act">
                        <div>
                            <h4>@li.Get("action")</h4>
                            <h5>@(new DateTime(long.Parse(li.Get("datetime"))).ToString())</h5>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
