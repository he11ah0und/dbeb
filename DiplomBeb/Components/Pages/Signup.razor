@rendermode RenderMode.InteractiveServer

@page "/signup"

<div class="main-div">
    <div class="place-column">
        <div class="linner-left">
            <img src="../icons/logo-ico.svg" alt="Логотип портфолио"/>
        </div>
        <div class="linner-right">
            <div class="heading">
                <h1>Регистрация аккаунта</h1>
            </div>
                    
            <div class="warp">
                <div class="place-linner-1">
                    <div>
                        <input type="text" id="" placeholder="" @bind="Name">
                        <label for="name">Имя</label>
                    </div>
                    <div>
                        <input type="text" id="" placeholder="" @bind="Surname">
                        <label for="">Фамилия</label>
                    </div>
                </div>
                        
                <div class="place-linner-2">
                    <div>
                        <input type="text" id="" placeholder="" @bind="Middlename">
                        <label for="">Отчество (при наличии)</label>
                    </div>
                    <div>
                        <input type="email" id="" placeholder="" @bind="Email">
                        <label for="">Email</label>
                    </div>
                    <div>
                        <input type="password" id="" placeholder="" @bind="Password">
                        <label for="">Пароль</label>
                    </div>
                    <div>
                        <input type="password" id="" placeholder="" @bind="ConfirmPassword">
                        <label for="">Подтверждение пароля</label>
                    </div>
                </div>

                <div class="place-linner-3">
                    <input class="checkbox" type="checkbox" name="" @bind="Confirmed">
                    <h4>Я согласен(сна) на обработку персональных данных</h4>
                </div>

                <div class="place-linner-4">
                    <button @onclick="OnRegistrate">регистрация</button>
                    <div class="horizontal-line"></div>
                </div>

                <div class="place-linner-5">
                    <h4>У вас уже есть аккаунт?</h4>
                    <a href="/account">Войти</a>
                </div>
            </div>
        </div>
    </div>
</div>

