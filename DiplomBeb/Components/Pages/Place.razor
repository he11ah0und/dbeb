@page "/place/{PlaceId:long}"
@using DiplomBeb.Components.Views
@using dshared.Utils
@rendermode RenderMode.InteractiveServer
<PageTitle>@UserService.Place.ListView.Header</PageTitle>
<div class="main-div">
    <div class="middle">
        <ViewList
            ListView="@UserService.Place.ListView"/>
        @if (UserService.Place.CurrentInPlace)
        {
            <div class="container-current">
                <ul class="student-list">
                    @if (UserService.Place._accountService.Account is ListElement a)
                    {
                        <li>
                            <div class="place">@UserService.Place.CurrentPlaceId</div>
                            <div class="image"></div>
                            <div class="name">
                                <h4>@a.Get("surname") @a.Get("name") @a.Get("middlename")</h4>
                                <p>@a.Get("webrole_name")</p>
                            </div>
                            <div class="score">
                                <h4>@a.Get("score")</h4>
                                <img src="/icons/star1-ico.svg" alt="">
                            </div>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</div>