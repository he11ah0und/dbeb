@using DiplomBeb.Utils.AdaptiveListing
@using dshared.Utils
@{
    var hasLink = DataResolver.IsHave("link");
    var mainTextContent = (DataResolver.IsHave("surname", "middlename")
        ? $"{ListElement.GetCombined(" ","surname", Id, "middlename")}"
        : ListElement.Get(Id));
}
<div class="name">
    @if (hasLink)
    {
        <a target="_blank" href="@ListElement.Get("link")">@mainTextContent</a>
    }
    else
    {
        <h4>@mainTextContent</h4>
    }
    @if (DataResolver.IsHave("webrole_name"))
    {
        <p>@ListElement.Get("webrole_name")</p>
    }
</div>

@code {
    [Parameter]
    public DataResolver DataResolver { get; set; }
    [Parameter]
    public ulong Index { get; set; }
    [Parameter]
    public string Id { get; set; }
    [Parameter]
    public ListElement ListElement { get; set; }
    [Parameter]
    public Action<ObjectContainer> OnCallback { get; set; }
}