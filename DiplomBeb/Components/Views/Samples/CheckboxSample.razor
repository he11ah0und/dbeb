@using DiplomBeb.Utils.AdaptiveListing
@using dshared.Utils
<div>
    <input name="value" type="checkbox" @onchange="OnClick">
    <h4>@ListElement.Get(Id)</h4>
</div>

@code{
    private void OnClick(ChangeEventArgs cargs)
    {
        var args = new ObjectContainer();
        args.Set("value", cargs.Value);
        OnCallback?.Invoke(args);
    }
}

@code {
    [Parameter]
    public DataResolver DataResolver { get; set; }
    [Parameter]
    public ulong Index { get; set; }
    [Parameter]
    public string Id { get; set; }
    [Parameter]
    public ListElement ListElement { get; set; }
    [Parameter]
    public Action<ObjectContainer> OnCallback { get; set; }
}