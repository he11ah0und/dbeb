@using DiplomBeb.Utils.AdaptiveListing
@using DiplomBeb.Utils.Networking
@using dshared.Utils
@rendermode RenderMode.InteractiveServer
<script src="../Components/Views/Samples/DocumentSample.razor.js"></script>

<div class="awards-cell">
    @{
        var bordered = Value ? "img-border" : "";
    }
    <div class="img @bordered">
        @if (Data.LongLength > 0)
        {
            <img  src="data:image;base64, @Convert.ToBase64String(Data)" alt="документ">
        }
        <input type="checkbox" class="checkbox" @onchange="OnClick">
    </div>

    <div class="rating-award">
        <div class="linner-rating-award">
        @if (bool.TryParse(ListElement.Get("moderated"), out bool ok) && ok)
        {
            <h3>+@ListElement.Get("cost")</h3>
            <img src="/icons/star1-ico.svg" alt="звёзды"/>
        }
        else
        {
            <h3>Документ обрабывается модератором</h3>
        }
        </div>
        <h4>@ListElement.Get(Id)</h4>
    </div>
</div>

@code {

    [Inject]
    public BackendHttpClient _http { get; set; }


    private byte[] Data { get; set; } = [];

    protected override async Task OnParametersSetAsync()
    {
        await Get();
        StateHasChanged();
    }

    private async Task Get()
    {
        var res = await _http.Request($"Documents/down/{ListElement.Get("id")}");
        if (!res.IsOk) return;
        var s = await res.Value.Content.ReadAsStreamAsync();
        var ms = new MemoryStream();
        await s.CopyToAsync(ms);
        Data = ms.ToArray();
    }

    private bool Value;
    private void OnClick(ChangeEventArgs cargs)
    {
        Value = (bool)cargs.Value;
        StateHasChanged();
        var args = new ObjectContainer();
        args.Set("value", Value);
        OnCallback?.Invoke(args);
    }
}

@code {
    [Parameter] public DataResolver DataResolver { get; set; }
    [Parameter] public ulong Index { get; set; }
    [Parameter] public string Id { get; set; }
    [Parameter] public ListElement ListElement { get; set; }
    [Parameter] public Action<ObjectContainer> OnCallback { get; set; }
}