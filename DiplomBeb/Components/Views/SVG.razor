@using System.Text.Json
@using DiplomBeb.Services.Client
@if (SvgCache.GetCachedInstance(CacheId, out var cache))
{
    @cache
}
<script src="../Components/Views/SVG.razor.js"></script>
@code {
    [Parameter]
    public string Source { get; set; }

    [Parameter]
    public string Class { get; set; }

    [Parameter]
    public string Id { get; set; }

    private HttpClient Http { get; set; }

    [Inject]
    private IJSRuntime JSRuntime { get; set; }

    [Inject]
    private NavigationManager NavManager { get; set; }

    [Inject]
    private SvgCache SvgCache { get; set; }
    
    private string SvgContent { get; set; }
    private CacheId CacheId { get; set; }
    
    private bool IsCachedInstance { get; set; }
    private bool IsCachedSvg { get; set; }
    private CacheData CacheSvg;
    private RenderFragment CacheInstance;
    
    protected override async Task OnInitializedAsync()
    {
        Http = new HttpClient();

        IsCachedSvg = SvgCache.CachedSvgs.TryGetValue(Source, out CacheSvg);
        if (!IsCachedSvg)
        {
            var absoluteUrl = NavManager.ToAbsoluteUri(Source).ToString();
            SvgContent = await Http.GetStringAsync(absoluteUrl);
            
        }
        CacheId = new CacheId(Class, Source);
        IsCachedInstance = SvgCache.CachedInstances.TryGetValue(CacheId, out CacheInstance);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || string.IsNullOrEmpty(Source)) return;

        try
        {
            
            if (!IsCachedSvg)
            {
                var svgParams = await JSRuntime.InvokeAsync<SvgParameters>("parse", SvgContent);

                if (svgParams == null)
                {
                    await Console.Error.WriteLineAsync("Failed to parse SVG.");
                    return;
                }

                if (svgParams?.Root == null)
                {
                    await Console.Error.WriteLineAsync("SVG parsing returned null root.");
                }
                
                CacheSvg = new CacheData(RenderElements(svgParams), svgParams);
                SvgCache.CachedSvgs.Add(Source, CacheSvg);
            }

            if (!IsCachedInstance)
            {
                CacheInstance = RenderElement(CacheSvg.sp.Root, CacheSvg.rf);
                SvgCache.SaveCachedInstance(CacheId, CacheInstance);
            }
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await Console.Error.WriteLineAsync($"Error loading/parsing SVG: {ex.Message}");
        }
    }
    
    private RenderFragment RenderElement(SvgElement element, RenderFragment cached)
    {
        return builder =>
        {
            builder.OpenElement(0, element.TagName);
            
            builder.AddAttribute(1, "class", Class);
            builder.AddAttribute(2, "id", Id);

            foreach (var attr in element.Attributes)
            {
                builder.AddAttribute(3, attr.Key, attr.Value);
            }

            builder.AddContent(4, cached);

            builder.CloseElement();
        };
    }
    
    private RenderFragment RenderElements(SvgParameters element)
    {
        return builder =>
        {
            foreach (var child in element.Root.Children)
            {
                builder.AddContent(2, RenderContent(child));
            }
        };
    }

    private RenderFragment RenderContent(SvgElement element)
    {
        return builder =>
        {
            builder.OpenElement(0, element.TagName);

            foreach (var attr in element.Attributes)
            {
                builder.AddAttribute(1, attr.Key, attr.Value);
            }

            foreach (var child in element.Children)
            {
                builder.AddContent(2, RenderContent(child));
            }

            builder.CloseElement();
        };
    }
}