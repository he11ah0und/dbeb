@rendermode RenderMode.InteractiveServer

<div class="sidebar">
	<h1 class="heading">
		<SVG Class="logo-icon" Source="/icons/logo-ico.svg"/>
		Цифровое портфолио
	</h1>
	<ul class="navigation">
		<li>
			<button @onclick="GoToMain"><SVG Class="nav-icon" Source="/icons/star-ico.svg"/>Общий рейтинг</button>
		</li>
		<li>
			<button @onclick="GoToLibrary" href="/library/1"><SVG Class="nav-icon" Source="/icons/biblio-ico.svg"/>Библиотека ссылок</button>
		</li>
		<li>
			<button @onclick="GoToAbout"><SVG Class="nav-icon" Source="/icons/info-ico.svg"/>О сервисе</button>
		</li>
		@if (AccountService.IsLogged && 
		     ulong.TryParse(AccountService?.Account?.Get("apirole_id"), out var val)
		     && val > 1)
		{
			<li>
				<button @onclick="SwitchModeration"><SVG Class="mod-icon" Source="/icons/moder-ico.svg"/>Модерация</button>
				@if (OpenedModeration)
				{
					<button @onclick="GoToModLogs"><img/>Логи</button>
					<button @onclick="GoToModProfiles"><img/>Пользователи</button>
					<button @onclick="GoToModDocs"><img/>Документы</button>
					@if (AccountService?.Account?.Get("apirole_name") == "admin")
					{
						<button @onclick="GoToModRequests"><img/>Запросы</button>
					}
				}
			</li>
		}
	</ul>
	<div class="bottom">
		<button class="profile" @onclick="GoToAccount">
			@if (AccountService?.AvatarImage is { LongLength: > 0 } data)
			{
				<img src="data:image;base64,@Convert.ToBase64String(data)" alt="аватар"/>
			}
			else
			{
				<SVG Class="prof-icon" Source="/icons/profil-ico.svg"/>
			}
			<div>
				@if (AccountService.IsLogged)
				{
					<h3>@AccountService?.Account?.GetCombined(" ", "name", "middlename")</h3>
					<h4>@AccountService?.Account?.Get("webrole_name")</h4>
				}
				else
				{
					<h4>Авторизоваться</h4>
				}
			</div>
		</button>
		<div class="spec-side">
			<button class="spec-side">
				@if (LowViewState)
				{
					<script src="https://lidrekon.ru/slep/js/jquery.js"></script>
					<script src="https://lidrekon.ru/slep/js/uhpv-full.min.js"></script>
				}
				<SVG Class="prof-icon" Source="/icons/slab-vid-ico.svg" OnClick="OnSwitchLowView"/>
			</button>
			
			<button @onclick="ThemeService.Change">
				<SVG Class="prof-icon" Source="/icons/sun-ico.svg"/>
			</button>
		</div>
	</div>
</div>
