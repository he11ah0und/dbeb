@rendermode RenderMode.InteractiveServer

<div class="sidebar">
	<h1 class="heading">
		<img src="icons/logo-ico.svg" alt="Логотип портфолио" />Цифровое портфолио
	</h1>
	<ul class="navigation">
		<li>
			<button @onclick="GoToMain"><img src="icons/star-ico.svg" alt="Общий рейтинг" />Общий рейтинг</button>
		</li>
		<li>
			<button @onclick="GoToLibrary" href="/library/1">
				<img src="icons/biblio-ico.svg" alt="Библиотека ссылок" />Библиотека
				ссылок
			</button>
		</li>
		<li>
			<button @onclick="GoToAbout"><img src="icons/info-ico.svg" alt="О сервисе" />О сервисе</button>
		</li>
		@if (AccountService.IsLogged && 
		     ulong.TryParse(AccountService?.Account?.Get("apirole_id"), out var val)
		     && val > 1)
		{
			<li>
				<button @onclick="SwitchModeration"><img src="/icons/moder-ico.svg"/>Модерация</button>
				@if (OpenedModeration)
				{
					<button @onclick="GoToModLogs"><img/>Логи</button>
					<button @onclick="GoToModProfiles"><img/>Пользователи</button>
					<button @onclick="GoToModDocs"><img/>Документы</button>
					@if (AccountService?.Account?.Get("apirole_name") == "admin")
					{
						<button @onclick="GoToModRequests"><img/>Запросы</button>
					}
				}
			</li>
		}
	</ul>
	<div class="bottom">
		<button class="profile"  @onclick="GoToAccount">
			<img class="img38" src="/icons/profil-ico.svg" alt="Аватар" />
			<div>
				@if (AccountService.IsLogged)
				{
					<h3>@AccountService?.Account?.GetCombined(" ", "name", "middlename")</h3>
					<h4>@AccountService?.Account?.Get("webrole_name")</h4>
				}
				else
				{
					<h4>Авторизоваться</h4>
				}
			</div>
		</button>
		<div class="spec-side">
			<button class="spec-side">
				<!-- ДЛЯ СЛЕПЫХ -->
				<script src="https://lidrekon.ru/slep/js/jquery.js"></script>
				<script src="https://lidrekon.ru/slep/js/uhpv-hover-full.min.js"></script>
				<!-- ДЛЯ СЛЕПЫХ -->
				<!--<img id="specialButton" style="cursor:pointer;" src="https://lidrekon.ru/images/special.png" alt="ВЕРСИЯ ДЛЯ СЛАБОВИДЯЩИХ" title="ВЕРСИЯ ДЛЯ СЛАБОВИДЯЩИХ"/>-->
				<img class="img38" id="specialButton" style="cursor:pointer;" src="/icons/slab-vid-ico.svg" alt="ВЕРСИЯ ДЛЯ СЛАБОВИДЯЩИХ" title="ВЕРСИЯ ДЛЯ СЛАБОВИДЯЩИХ"/>
				<!--<img class="img38" src="/icons/slab-vid-ico.svg" alt="Кнопка для слабовидящих"/>-->
			</button>
			
			<button @onclick="ThemeService.Change">
				<img id="theme-switch" class="img38" src="/icons/sun-ico.svg" alt="Кнопка смены темы" />
			</button>
		</div>
	</div>
</div>
