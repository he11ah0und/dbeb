@rendermode RenderMode.InteractiveServer

@if (!_listView.HideHeading)
{
    <div class="heading">
        <div>@_listView.Header</div>
        <div>Всего: @_listView.Total</div>
    </div>
}
@{
    var height = _listView.FitContent ? "minHeight" : "maxHeight";
}
<div class="container-list @height">
    <div class="table-wrapper">
        <table class="student-table">
            @{
                var resolved = _listView.DataResolver.Props
                    .Select(prop => _listView.DataResolver.ResolvePropName(prop))
                    .Where(resolved => !string.IsNullOrEmpty(resolved));
            }
            @if (!_listView.HideTableHeader)
            {
                <thead>
                <tr class="heading-list">
                    @foreach (var r in resolved)
                    {
                        <th class="normal">@r</th>
                    }
                </tr>
                </thead>
            }
            <tbody class="student-list">
            @for (long i = 1; i <= _listView.Data.LongLength; i++)
            {
                var io = i - 1;
                var listElement = _listView.Data[io];
                var hasId = _listView.DataResolver.Props.Contains("id");
                var idInLe = string.IsNullOrEmpty(listElement.Get("id"));
                if (hasId && !idInLe)
                {
                    listElement.Set("id", i);
                }
                <tr>
                    @{
                        var listProps = _listView.DataResolver.GetListProps(_listView.DataResolver.Props, listElement.Elements);
                        var renderedProps = listProps
                            .Select(pair => _listView.DataResolver.GetProp(pair.Key, listElement, (ulong)i, _listView))
                            .Where(rendered => rendered.Ok);
                    }
                        
                    @foreach (var rendered in renderedProps)
                    {
                        var td_style = _listView.SlimTableData ? "slim" : "normal";
                        <td class="@td_style">
                            <DynamicComponent Type="@rendered.ListProp.RenderType" Parameters="rendered.Parameters" />
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (!_listView.HideFooter)
    {
        <div class="footer">
            @if (!_listView.HideLeftFooterButtons)
            {
                <div class="footer-left">
                    <button class="update" @onclick="_listView.Update">
                        <img class="img-update" src="/icons/update.svg" alt="">
                    </button>
                </div>
            }
            @if (!_listView.HideRightFooterButtons)
            {
                <div class="footer-right">
                    @if (_listView.CanPrevious)
                    {
                        <button class="nazad" @onclick="_listView.PreviousPage"><img src="/icons/nazad.svg" alt=""></button>
                    }
                    @for (ulong i = 1; i <= _listView.MaxPages; i++)
                    {
                        <button @onclick="() => _listView.SpecificPage(i)">@(i)</button>
                    }
                    @if (_listView.CanNext)
                    {
                        <button class="vpered" @onclick="_listView.NextPage"><img src="/icons/vpered.svg" alt=""></button>
                    }
                </div>
            }
        </div>
    }
</div>