@rendermode RenderMode.InteractiveServer
@if (!_listView.HideHeading)
{
    <div class="heading">
        <div>@_listView.Header</div>
        <div>Всего: @_listView.Total</div>
    </div>
}
@{
    var height = _listView.FitContent ? "minHeight" : "maxHeight";
}
<div class="container-list @height">
    <div class="wrapper">
        @if (_listView.ContentType is not null)
        {
            <DynamicComponent Type="@_listView.ContentType" Parameters="_listView.GetParamsForContent().Objects"/>
        }
    </div>
    @if (!_listView.HideFooter)
    {
        <div class="footer">
            @if (!_listView.HideLeftFooterButtons)
            {
                <div class="footer-left">
                    <button class="update" @onclick="_listView.Update">
                        <img class="img-update" src="/icons/update.svg" alt="">
                    </button>
                </div>
            }
            @if (!_listView.HideRightFooterButtons)
            {
                <div class="footer-right">
                    @if (_listView.CanPrevious)
                    {
                        <button class="nazad" @onclick="_listView.PreviousPage"><img src="/icons/nazad.svg" alt="">
                        </button>
                    }
                    @if (_listView.MaxPages > 1)
                    {
                        for (ulong i = 1; i <= _listView.MaxPages; i++)
                        {
                            var i1 = i;
                            <button @onclick="() => _listView.SpecificPage(i1)">@i1</button>
                        }
                    }
                    @if (_listView.CanNext)
                    {
                        <button class="vpered" @onclick="_listView.NextPage"><img src="/icons/vpered.svg" alt="">
                        </button>
                    }
                </div>
            }
        </div>
    }
</div>
