@rendermode RenderMode.InteractiveServer

@if (!ListView.HideHeading)
{
    <div class="heading">
        <div>@ListView.Header</div>
        <div>Всего: @ListView.Total</div>
    </div>
}
@{
    var height = ListView.FitContent ? "minHeight" : "maxHeight";
}
<div class="container-list @height">
    <div class="table-wrapper">
        <table class="student-table">
            @{
                var resolved = ListView.DataResolver.Props
                    .Select(prop => ListView.DataResolver.ResolvePropName(prop))
                    .Where(resolved => !string.IsNullOrEmpty(resolved));
            }
            @if (!ListView.HideTableHeader)
            {
                <thead>
                <tr class="heading-list">
                    @foreach (var r in resolved)
                    {
                        <th>@r</th>
                    }
                </tr>
                </thead>
            }
            <tbody class="student-list">
            @for (long i = 1; i <= ListView.Data.LongLength; i++)
            {
                var io = i - 1;
                var listElement = ListView.Data[io];
                var hasId = ListView.DataResolver.Props.Contains("id");
                var idInLe = string.IsNullOrEmpty(listElement.Get("id"));
                if (hasId && !idInLe)
                {
                    listElement.Set("id", i);
                }
                <tr>
                    @{
                        var listProps = ListView.DataResolver.GetListProps(ListView.DataResolver.Props, listElement.Elements);
                        var renderedProps = listProps
                            .Select(pair => ListView.DataResolver.GetProp(pair.Key, listElement, (ulong)i))
                            .Where(rendered => rendered.Ok);
                    }
                        
                    @foreach (var rendered in renderedProps)
                    {
                        <td>
                            <DynamicComponent Type="@rendered.ListProp.RenderType" Parameters="rendered.Parameters" />
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (!ListView.HideFooter)
    {
        <div class="footer">
            @if (!ListView.HideLeftFooterButtons)
            {
                <div class="footer-left">
                    <button class="update" @onclick="ListView.Update">
                        <img class="img-update" src="/icons/update.svg" alt="">
                    </button>
                </div>
            }
            @if (!ListView.HideRightFooterButtons)
            {
                <div class="footer-right">
                    @if (ListView.CanPrevious)
                    {
                        <button class="nazad" @onclick="ListView.PreviousPage"><img src="/icons/nazad.svg" alt=""></button>
                    }
                    @for (ulong i = 1; i <= ListView.MaxPages; i++)
                    {
                        <button @onclick="() => ListView.SpecificPage(i)">@(i)</button>
                    }
                    @if (ListView.CanNext)
                    {
                        <button class="vpered" @onclick="ListView.NextPage"><img src="/icons/vpered.svg" alt=""></button>
                    }
                </div>
            }
        </div>
    }
</div>