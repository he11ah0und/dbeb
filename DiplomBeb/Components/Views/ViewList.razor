@rendermode RenderMode.InteractiveServer

<div class="heading">
    <div>@ListView.Header</div>
    <div>Всего: @ListView.Total</div>
</div>
<div class="container-list">
    <div class="table-wrapper">
        <table class="student-table">
            <thead>
                <tr class="heading-list">
                    <th>№</th>
                    <th>Аватар</th>
                    <th>ФИО</th>
                    <th>Действие</th>
                    <th>Время</th>
                    <th>Звезды</th>
                </tr>
            </thead>
            <tbody class="student-list">
                <tr>
                    <td>
                        <h4>1</h4>
                    </td>
                    <td>
                        <div class="image"></div>
                    </td>
                    <td class="name">
                        <h4>Акакий Акакиевич Акаков</h4>
                        <p>Студент</p>
                    </td>
                    <td>
                        <h4>Вышел из системы</h4>
                    </td>
                    <td>
                        <h4>22:00</h4>
                    </td>
                    <td class="star">
                        <div class="stars-container">
                            <h4>1000</h4>
                            <img src="/icons/star1-ico.svg" alt="">
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="footer">
        <div class="footer-left">
            <button class="update">
                <img class="img-update" src="/icons/update.svg" alt="">
            </button>
        </div>
        <div class="footer-right">
            <a href="#"><button class="nazad"><img src="/icons/nazad.svg" alt=""></button></a>
            <a href="#">1</a>
            <a href="#">2</a>
            <a href="#">3</a>
            <a href="#"><button class="vpered"><img src="/icons/vpered.svg" alt=""></button></a>
        </div>
    </div>
</div>